#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
encrypted_instructions="$repo_root/.codex-private/AGENTS.private.sops.yaml"
encrypted_skill="$repo_root/.codex-private/skills/assess-upstream-template/skill.sops.yaml"
encrypted_renovate_skill="$repo_root/.codex-private/skills/assess-renovate-prs/skill.sops.yaml"
override="$repo_root/AGENTS.override.md"
key="$repo_root/age.key"
temporary_override="$(mktemp)"
temporary_skill="$(mktemp -d)"
temporary_renovate_skill="$(mktemp -d)"
runtime_skill="$repo_root/.agents/skills/assess-upstream-template"
runtime_renovate_skill="$repo_root/.agents/skills/assess-renovate-prs"

cleanup() {
  rm -f "$temporary_skill/SKILL.md" "$temporary_skill/openai.yaml" "$temporary_skill/assessment.py"
  rmdir "$temporary_skill" 2>/dev/null || true
  rm -f "$temporary_renovate_skill/SKILL.md" "$temporary_renovate_skill/openai.yaml" "$temporary_renovate_skill/assessment.py"
  rmdir "$temporary_renovate_skill" 2>/dev/null || true
  rm -f "$temporary_override" "$override"
}
trap cleanup EXIT INT TERM

if [[ ! -f "$key" ]]; then
  echo "Missing SOPS age identity: $key" >&2
  exit 1
fi

umask 077
mkdir -p "$runtime_skill/agents" "$runtime_skill/scripts"
SOPS_AGE_KEY_FILE="$key" mise exec -- sops --decrypt --extract '["skill_md"]' "$encrypted_skill" >"$temporary_skill/SKILL.md"
SOPS_AGE_KEY_FILE="$key" mise exec -- sops --decrypt --extract '["openai_yaml"]' "$encrypted_skill" >"$temporary_skill/openai.yaml"
SOPS_AGE_KEY_FILE="$key" mise exec -- sops --decrypt --extract '["helper_py"]' "$encrypted_skill" >"$temporary_skill/assessment.py"
install -m 600 "$temporary_skill/SKILL.md" "$runtime_skill/SKILL.md"
install -m 600 "$temporary_skill/openai.yaml" "$runtime_skill/agents/openai.yaml"
install -m 700 "$temporary_skill/assessment.py" "$runtime_skill/scripts/assessment.py"

mkdir -p "$runtime_renovate_skill/agents" "$runtime_renovate_skill/scripts"
SOPS_AGE_KEY_FILE="$key" mise exec -- sops --decrypt --extract '["skill_md"]' "$encrypted_renovate_skill" >"$temporary_renovate_skill/SKILL.md"
SOPS_AGE_KEY_FILE="$key" mise exec -- sops --decrypt --extract '["openai_yaml"]' "$encrypted_renovate_skill" >"$temporary_renovate_skill/openai.yaml"
SOPS_AGE_KEY_FILE="$key" mise exec -- sops --decrypt --extract '["helper_py"]' "$encrypted_renovate_skill" >"$temporary_renovate_skill/assessment.py"
install -m 600 "$temporary_renovate_skill/SKILL.md" "$runtime_renovate_skill/SKILL.md"
install -m 600 "$temporary_renovate_skill/openai.yaml" "$runtime_renovate_skill/agents/openai.yaml"
install -m 700 "$temporary_renovate_skill/assessment.py" "$runtime_renovate_skill/scripts/assessment.py"

{
  echo '<!-- Generated by scripts/codex-private; do not edit. -->'
  echo
  cat "$repo_root/AGENTS.md"
  echo
  SOPS_AGE_KEY_FILE="$key" mise exec -- sops --decrypt --extract '["instructions"]' "$encrypted_instructions"
} >"$temporary_override"
mv "$temporary_override" "$override"

cd "$repo_root"
mise exec -- codex "$@"
