+def _legacy_credentials(
+    ca_cert_pem: str, ca_key_pem: str, existing_leaf: tuple[str, str] | None
+) -> tuple[str, str]:
+    # shortcut: opt-in application bundle for WW80K6404QW; remove after upstream supports importing it.
+    path = Path("/config/localthings-legacy.pem")
+    if not path.exists():
+        return existing_leaf or _mint_preferred(ca_cert_pem, ca_key_pem)
+    try:
+        with path.open() as file:
+            bundle = file.read(65537)
+        keys = re.findall(
+            r"-----BEGIN (?:RSA )?PRIVATE KEY-----.*?-----END (?:RSA )?PRIVATE KEY-----",
+            bundle,
+            re.DOTALL,
+        )
+        certificates = re.findall(
+            r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----", bundle, re.DOTALL
+        )
+        if len(bundle) > 65536 or len(keys) != 1 or not certificates:
+            raise ValueError
+        cert, key = "\n".join(certificates) + "\n", keys[0] + "\n"
+        client_context(cert, key)
+        return cert, key
+    except (OSError, UnicodeError, ValueError):
+        raise InvalidCA("Invalid legacy application certificate bundle") from None


